<!-- Swimlanes -->
<mxCell id="swimlane-trigger" value="Issue Detection" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#ffebee;strokeColor=#c62828;fontColor=#b71c1c;" vertex="1" parent="1">

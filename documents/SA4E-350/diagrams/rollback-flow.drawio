<mxGeometry x="30" y="200" width="180" height="80" as="geometry"/>
</mxCell>
<mxCell id="assess-critical" value="CRITICAL:<br>- Extension fails to load<br>- Data integrity issue<br>- Complete indexing failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontColor=#b71c1c;" vertex="1" parent="swimlane-assess">
<mxGeometry x="250" y="200" width="280" height="80" as="geometry"/>
</mxCell>
<mxCell id="assess-major" value="MAJOR:<br>- @baseclass rules not found<br>- Indexing hangs<br>- Auth errors silent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#e65100;" vertex="1" parent="swimlane-assess">
<mxGeometry x="570" y="200" width="280" height="80" as="geometry"/>

<!-- Rollback Execution Steps -->
<mxCell id="rb-1" value="1. Stop new version:<br>kiro --uninstall-extension dnguyenminh.sdlc-agents-4-enterprise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#ad1457;fontColor=#880e4f;" vertex="1" parent="swimlane-rollback">
<mxGeometry x="30" y="360" width="360" height="70" as="geometry"/>
</mxCell>
<mxCell id="rb-2" value="2. No database rollback needed<br>(extension-only, no DB changes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#ad1457;fontColor=#880e4f;" vertex="1" parent="swimlane-rollback">
<mxGeometry x="420" y="360" width="360" height="70" as="geometry"/>
</mxCell>
<mxCell id="rb-3" value="3. Deploy previous version:<br>kiro --install-extension sdlc-agents-4-enterprise-1.47.2.vsix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#ad1457;fontColor=#880e4f;" vertex="1" parent="swimlane-rollback">
<mxGeometry x="810" y="360" width="360" height="70" as="geometry"/>
</mxCell>
<mxCell id="rb-4" value="4. Reload window:<br>Ctrl+Shift+P &rarr; Developer: Reload Window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#ad1457;fontColor=#880e4f;" vertex="1" parent="swimlane-rollback">
<mxGeometry x="30" y="450" width="360" height="70" as="geometry"/>
</mxCell>
<mxCell id="rb-5" value="5. Restore configuration:<br>Verify settings persist (no config changes in v1.48.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#ad1457;fontColor=#880e4f;" vertex="1" parent="swimlane-rollback">
<mxGeometry x="420" y="450" width="360" height="70" as="geometry"/>
</mxCell>
<mxCell id="rb-6" value="6. Notify stakeholders:<br>- GitHub Issue update<br>- Team Slack notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#ad1457;fontColor=#880e4f;" vertex="1" parent="swimlane-rollback">
<mxGeometry x="810" y="450" width="360" height="70" as="geometry"/>
</mxCell>


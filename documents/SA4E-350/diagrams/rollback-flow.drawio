<mxCell id="decision-major" value="Rollback<br>Required?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#e65100;fontStyle=1;" vertex="1" parent="swimlane-assess">

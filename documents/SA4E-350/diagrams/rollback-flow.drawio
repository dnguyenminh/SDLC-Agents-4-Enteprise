</mxCell>
<mxCell id="swimlane-assess" value="Severity Assessment" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fff3e0;strokeColor=#ef6c00;fontColor=#e65100;" vertex="1" parent="1">
<mxGeometry x="20" y="180" width="1200" height="140" as="geometry"/>
</mxCell>
<mxCell id="swimlane-rollback" value="Rollback Execution" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fce4ec;strokeColor=#ad1457;fontColor=#880e4f;" vertex="1" parent="1">

</mxCell>

<!-- Issue Detection -->
<mxCell id="trigger-1" value="Issue Detected:<br>- Extension fails to activate<br>- @baseclass rules show 'Not found'<br>- Indexing crashes/hangs<br>- Auth errors silent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontColor=#b71c1c;" vertex="1" parent="swimlane-trigger">
<mxGeometry x="30" y="40" width="560" height="80" as="geometry"/>
</mxCell>
<mxCell id="trigger-2" value="Alert Source:<br>- User report<br>- Automated monitoring<br>- CI/CD pipeline failure<br>- Manual testing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#ef6c00;fontColor=#e65100;" vertex="1" parent="swimlane-trigger">

<mxCell id="assess-minor" value="MINOR:<br>- UI cosmetic issue<br>- Performance degradation < 50%<br>- Non-blocking bug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontColor=#1b5e20;" vertex="1" parent="swimlane-assess">
<mxGeometry x="890" y="200" width="280" height="80" as="geometry"/>
</mxCell>

<!-- Decision diamonds -->

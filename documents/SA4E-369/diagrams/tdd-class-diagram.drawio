<mxCell id="t5" value="SA4E-369 TDD — Class Design (peer/ module; constructor injection, no DI framework)" style="text;html=1;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="10" width="680" height="26" as="geometry"/></mxCell>
<mxCell id="busc" value="PeerBus extends EventEmitter implements IPeerBus&#10;──────────────────────────&#10;- inboundQueues: Map&lt;tabId, taskId[]&gt;&#10;- busyTabs: Set&lt;tabId&gt;&#10;- sessionKeys: Map&lt;tabId, sessionKey&gt;&#10;+ send(from, target, msg, mode, origin): Promise&lt;SendResult&gt;&#10;- dispatch(tabId) — next-tick delivery&#10;- onTurnDone(taskId, output)&#10;+ notifyUserActivity(tabId) → guards.resetPair (BR-9)&#10;+ dispose()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="330" height="160" as="geometry"/></mxCell>
<mxCell id="regc" value="PeerRegistry implements IPeerRegistry&#10;──────────────────────────&#10;- entries: Map&lt;tabId, PeerRegistryEntry&gt;&#10;+ register(tabId, info) — idempotent (I-1)&#10;+ deregister(tabId) — emit AFTER delete&#10;+ setStatus(tabId, status) — no event&#10;+ snapshot(callerTabId): PeerInfo[] — deep copy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="guarc" value="AntiLoopGuards implements IAntiLoopGuards&#10;──────────────────────────&#10;- pairGuards: Map&lt;pairKey, PairGuardState&gt;&#10;- rateWindows: Map&lt;tabId, number[]&gt;&#10;+ evaluate(from, to, origin): GuardVerdict — sync&#10;+ resetPair(pairKey)&#10;+ releaseTab(tabId)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="790" y="60" width="310" height="120" as="geometry"/></mxCell>
<mxCell id="tmc" value="PeerTaskManager implements IPeerTaskManager&#10;──────────────────────────&#10;- tasks: Map&lt;taskId, PeerTask&gt;&#10;- waiters: Map&lt;taskId, BlockingWaiter&gt;&#10;+ create(task) / get(taskId): deep copy&#10;+ setRunning / setCompleted / setFailed / setCancelled&#10;+ awaitTerminal(taskId, timeoutMs): Promise&lt;SendResult&gt;&#10;+ cancelQueuedFor(tabId, err) — PEER_009&#10;+ disposeAll() — reject all waiters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="330" height="150" as="geometry"/></mxCell>

<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Participant headers -->
    <mxCell id="h1" value="Developer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="20" width="140" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="h2" value="Extension&#10;(Indexer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="20" width="140" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="h3" value="State Store&#10;(P1 backend / P2 cache)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="600" y="20" width="150" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="h4" value="Pega Rule&#10;Catalog API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="880" y="20" width="140" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="h5" value="Backend KB&#10;(content_hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1150" y="20" width="140" height="40" as="geometry"/>
    </mxCell>

    <!-- Lifelines -->
    <mxCell id="l1" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="130" y="60" as="sourcePoint"/><mxPoint x="130" y="820" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="l2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="60" as="sourcePoint"/><mxPoint x="400" y="820" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="l3" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="675" y="60" as="sourcePoint"/><mxPoint x="675" y="820" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="l4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="950" y="60" as="sourcePoint"/><mxPoint x="950" y="820" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="l5" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="60" as="sourcePoint"/><mxPoint x="1220" y="820" as="targetPoint"/></mxGeometry>
    </mxCell>

    <!-- Messages -->
    <mxCell id="m1" value="1. Chạy &quot;Index Source Code&quot;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="130" y="100" as="sourcePoint"/><mxPoint x="400" y="100" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m2" value="2. Yêu cầu Rule Catalog Export" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="140" as="sourcePoint"/><mxPoint x="950" y="140" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m3" value="3. CSV (có cột checksum, save-time based)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="950" y="180" as="sourcePoint"/><mxPoint x="400" y="180" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m4" value="4. Parse CSV: (pzInsKey, checksum) [+ verify Cách B]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="220" as="sourcePoint"/><mxPoint x="560" y="220" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m5" value="5. Nạp trạng thái đã-index (checksum lần trước)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="260" as="sourcePoint"/><mxPoint x="675" y="260" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m6" value="6. Tập checksum đã lưu" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="675" y="300" as="sourcePoint"/><mxPoint x="400" y="300" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m7" value="7. So checksum → SKIP unchanged, gom DELTA (mới/đổi)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="340" as="sourcePoint"/><mxPoint x="560" y="340" as="targetPoint"/></mxGeometry>
    </mxCell>

    <!-- loop label -->
    <mxCell id="loopbox" value="loop [chỉ với rule trong DELTA]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;fontSize=9;fontStyle=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
      <mxGeometry x="380" y="370" width="620" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="m8" value="8. Fetch chi tiết rule (delta)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="410" as="sourcePoint"/><mxPoint x="950" y="410" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m9" value="9. Nội dung rule" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="950" y="450" as="sourcePoint"/><mxPoint x="400" y="450" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m10" value="10. Index + cập nhật content_hash = checksum mới" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="490" as="sourcePoint"/><mxPoint x="1220" y="490" as="targetPoint"/></mxGeometry>
    </mxCell>

    <!-- after loop -->
    <mxCell id="m11" value="11. Lưu trạng thái checksum mới (skip + delta)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="550" as="sourcePoint"/><mxPoint x="675" y="550" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m12" value="12. Báo cáo kết quả (skipped=N, reindexed=M, removed=K)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="590" as="sourcePoint"/><mxPoint x="130" y="590" as="targetPoint"/></mxGeometry>
    </mxCell>

    <!-- note about removed rules -->
    <mxCell id="note1" value="Rule bị xóa: có trong state nhưng KHÔNG có trong CSV → đánh dấu removed (xử lý theo BR-11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
      <mxGeometry x="380" y="630" width="620" height="50" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>

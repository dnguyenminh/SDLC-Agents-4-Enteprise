<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Start -->
    <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="80" y="80" width="30" height="30" as="geometry"/>
    </mxCell>

    <!-- New -->
    <mxCell id="new" value="New&#10;(chưa có checksum trong state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="60" y="170" width="200" height="60" as="geometry"/>
    </mxCell>

    <!-- Compared / evaluated -->
    <mxCell id="eval" value="Evaluated&#10;(đối chiếu checksum CSV vs state)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="380" y="150" width="200" height="100" as="geometry"/>
    </mxCell>

    <!-- Unchanged (skip) -->
    <mxCell id="skip" value="Unchanged → SKIP&#10;(checksum khớp, không fetch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="700" y="60" width="220" height="60" as="geometry"/>
    </mxCell>

    <!-- Changed (re-index) -->
    <mxCell id="changed" value="Changed → RE-INDEX&#10;(checksum khác → vào DELTA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="700" y="180" width="220" height="60" as="geometry"/>
    </mxCell>

    <!-- Fetched/Indexed -->
    <mxCell id="indexed" value="Fetched / Indexed&#10;(content_hash = checksum mới đã lưu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="700" y="320" width="220" height="60" as="geometry"/>
    </mxCell>

    <!-- Removed -->
    <mxCell id="removed" value="Removed&#10;(còn trong state, không còn trong CSV)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="350" y="340" width="220" height="60" as="geometry"/>
    </mxCell>

    <!-- Persisted end state -->
    <mxCell id="persist" value="State Persisted&#10;(sẵn sàng cho lần chạy sau)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="380" y="470" width="200" height="60" as="geometry"/>
    </mxCell>

    <!-- Final -->
    <mxCell id="final" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="465" y="600" width="30" height="30" as="geometry"/>
    </mxCell>

    <!-- Edges -->
    <mxCell id="s1" value="rule xuất hiện trong CSV" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="start" target="new">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="s2" value="đưa vào so sánh" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="new" target="eval">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="s3" value="[checksum khớp]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;exitX=0.75;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="eval" target="skip">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="s4" value="[checksum khác / rule mới]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="eval" target="changed">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="s5" value="fetch delta + index" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="changed" target="indexed">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="s6" value="lưu checksum (giữ nguyên)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="skip" target="persist">
      <mxGeometry relative="1" as="geometry">
        <Array as="points"><mxPoint x="960" y="90"/><mxPoint x="960" y="500"/></Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="s7" value="lưu checksum mới" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="indexed" target="persist">
      <mxGeometry relative="1" as="geometry">
        <Array as="points"><mxPoint x="810" y="440"/><mxPoint x="640" y="440"/><mxPoint x="640" y="500"/></Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="s8" value="[không còn trong CSV]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="eval" target="removed">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="s9" value="dọn state (BR-11)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="removed" target="persist">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="s10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="persist" target="final">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>

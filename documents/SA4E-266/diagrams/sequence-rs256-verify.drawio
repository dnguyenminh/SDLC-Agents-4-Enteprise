    <mxCell id="m1" value="1. request + token" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;exitX=1;exitY=0;entryX=0;entryY=0" edge="1" parent="1" source="client" target="backend">
      <mxGeometry relative="1" as="geometry">

    <mxCell id="class-core-tools" value="CoreAgentTools\n────────────────────\n- db: QueryDatabaseAdapter\n- retrieval: SnapshotRetrievalService\n- embedFn: (text) → Buffer\n- sourceLoader: (path) → Promise&lt;string&gt;\n────────────────────\n+ search_symbols(args): Promise&lt;ToolResult&gt;\n+ get_file_skeleton(fp): Promise&lt;ToolResult&gt;\n+ read_code_block(fp, start, end): Promise&lt;ToolResult&gt;\n+ query_call_graph(symbolId, dir): Promise&lt;ToolResult&gt;\n- resolveSessionPin(args): SessionPin\n- hybridSearch(q, limit): Promise&lt;SymbolHit[]&gt;\n- fuseRanked(lexical, vector, graph): SymbolHit[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontFamily=monospace;" vertex="1" parent="boundary-tools">

<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="boundary-main" value="Token Budget State Machine (per Session)" style="swimlane;startSize=30;fillColor=none;strokeColor=#6c8ebf;html=1;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="680" height="840" as="geometry"/>
    </mxCell>
    <mxCell id="boundary-escalation" value="Escalation Path" style="swimlane;startSize=30;fillColor=none;strokeColor=#b85450;html=1;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="720" y="20" width="660" height="840" as="geometry"/>
    </mxCell>
    <mxCell id="state-init" value="INIT\n(resolveContextBudget)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="boundary-main">
      <mxGeometry x="240" y="50" width="200" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="state-compute" value="COMPUTE BUDGET\nstaticBudget = f(n_ctx)\nstaticTokens = base + tools + history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="boundary-main">
      <mxGeometry x="100" y="150" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="state-check" value="CHECK: staticTokens ≤ staticBudget?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="boundary-main">
      <mxGeometry x="390" y="150" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="state-ok" value="OK: Proceed\n(evidence_budget = available)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="boundary-main">
      <mxGeometry x="200" y="270" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="state-retrieval" value="RETRIEVAL + ASSEMBLY\n(AIContextService.getContext)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="boundary-main">
      <mxGeometry x="200" y="380" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="state-scratchpad" value="SCRATCHPAD EMITTED\n(Goal, DeadEnds, Facts, Plan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=10;" vertex="1" parent="boundary-main">
      <mxGeometry x="200" y="490" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="state-toolcall" value="TOOL CALL EXECUTION\n(search_symbols, read_code_block, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="boundary-main">
      <mxGeometry x="200" y="600" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="state-evict" value="BATCH EVICT CHECK\ntokens &gt; 75% budget?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="boundary-main">
      <mxGeometry x="390" y="600" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="state-evict-yes" value="EVICT HIGHEST S_evict\nS_evict = Age×200 + Tokens − Ref×1000\nTombstone: [evicted tool_call_id=&lt;id&gt;]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="boundary-main">
      <mxGeometry x="200" y="710" width="300" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="state-next" value="NEXT TURN\n(scratchpad with tombstones)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="boundary-main">
      <mxGeometry x="200" y="830" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="esc-1" value="ESCALATION 1: COMPRESS\n• Summarize history/scratchpad\n• steeringBudget = steeringBudget / 2\n• shouldCompress = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="boundary-escalation">
      <mxGeometry x="20" y="50" width="300" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="esc-2" value="ESCALATION 2: DROP-STEERING\n• Remove steering docs from context\n• minLoadout = true\n• Only core tools remain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="boundary-escalation">
      <mxGeometry x="20" y="170" width="300" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="esc-3" value="ESCALATION 3: MIN-LOADOUT\n• Core + Discovery tools only\n• Token cap enforced (default 1000)\n• capExceeded = true if unreachable\n• If still over → PiContextBudgetExceededError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="boundary-escalation">
      <mxGeometry x="20" y="290" width="300" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="esc-error" value="ERROR STATE\nPiContextBudgetExceededError\n&quot;Giảm steering/tools&quot;\nActionable guidance, not provider 400" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="boundary-escalation">
      <mxGeometry x="20" y="440" width="300" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="tier-box" value="TIER RESOLUTION (from real n_ctx)\n┌─────────────┬─────────────┬──────────────┐\n│ Tier        │ n_ctx       │ staticBudget │\n├─────────────┼─────────────┼──────────────┤\n│ Small       │ 8,192       │ ~3,000       │\n│ Medium      │ 32,768      │ ~12,000      │\n│ Large       │ 128,000     │ ~48,000      │\n└─────────────┴─────────────┴──────────────┘\nstaticTokens = real_token_count + base + toolSchema\nstaticTokens ≤ staticBudget (enforced)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=10;fontFamily=monospace;" vertex="1" parent="boundary-escalation">
      <mxGeometry x="20" y="550" width="300" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="role-box" value="ROLE-SCOPE REDUCTION\n┌──────────┬───────┬───────┐\n│ Role     │ Base  │ Scoped│\n├──────────┼───────┼───────┤\n│ BA       │ 5     │ 1     │\n│ SM       │ 5     │ 1     │\n│ SA       │ 5     │ 2     │\n│ DEV      │ 5     │ 3     │\n│ QA       │ 5     │ 2     │\n│ DevOps   │ 5     │ 2     │\n│ UI       │ 5     │ 1     │\n│ Security │ 5     │ 1     │\n│ UNKNOWN  │ 5     │ 5     │ (fail-open)\n└──────────┴───────┴───────┘\nscopedSteeringTokens &lt; baseTokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=10;fontFamily=monospace;" vertex="1" parent="boundary-escalation">
      <mxGeometry x="340" y="550" width="300" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="tool-box" value="TOOL LOADOUT CAP\n• BA: excludes deploy/git/build\n• DEV: keeps git/build\n• Core + Discovery always present\n• Explicit cap (1000) → trim to ≤ 1000\n• cap = 1 → capExceeded (BR-06 minimum)\n• Minimal mode = core + discovery only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontFamily=monospace;" vertex="1" parent="boundary-escalation">
      <mxGeometry x="20" y="790" width="300" height="120" as="geometry"/>
    </mxCell>

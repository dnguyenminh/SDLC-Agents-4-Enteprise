<!-- Trigger -->
<mxCell id="trigger" value="🚨 Issue Detected\n(Production Incident)" style="ellipse;html=1;fillColor=#f44336;strokeColor=#c62828;fontColor=white;fontSize=12;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="500" y="40" width="160" height="50" as="geometry"/>
</mxCell>

<!-- Severity Assessment -->
<mxCell id="assess" value="Assess Severity\n& Impact" style="rounded=1;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontColor=#e65100;fontSize=11;" vertex="1" parent="1">
<mxGeometry x="480" y="120" width="140" height="50" as="geometry"/>
</mxCell>

<!-- Decision: Critical? -->
<mxCell id="critical" value="Critical Defect?\n(Data loss, security,\nperf >50%, data integrity)" style="rhombus;html=1;fillColor=#ffeb3b;strokeColor=#f57f17;fontColor=#f57f17;fontSize=11;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="480" y="200" width="140" height="70" as="geometry"/>
</mxCell>

<!-- Critical Path: Immediate Rollback -->
<mxCell id="immediate" value="⚡ IMMEDIATE\nROLLBACK\n(INITIATE §8.3)" style="ellipse;html=1;fillColor=#f44336;strokeColor=#c62828;fontColor=white;fontSize=11;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="480" y="300" width="140" height="50" as="geometry"/>
</mxCell>

<!-- Non-Critical Path: Hotfix Assessment -->
<mxCell id="hotfix-assess" value="Hotfix Possible?\n(Minor UI, workaround\navailable)" style="rhombus;html=1;fillColor=#ffeb3b;strokeColor=#f57f17;fontColor=#f57f17;fontSize=11;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="700" y="200" width="140" height="60" as="geometry"/>
</mxCell>

<mxCell id="hotfix" value="🔧 Hotfix Path\n- Create fix branch\n- Fast-track test\n- Deploy patch\n- No rollback" style="rounded=1;html=1;fillColor=#4caf50;strokeColor=#2e7d32;fontColor=white;fontSize=11;" vertex="1" parent="1">
<mxGeometry x="700" y="300" width="140" height="60" as="geometry"/>
</mxCell>

<mxCell id="wait-decision" value="⏳ Wait for PM/SM\nDecision\n(Escalate if needed)" style="rounded=1;html=1;fillColor=#ff9800;strokeColor=#e65100;fontColor=white;fontSize=11;" vertex="1" parent="1">
<mxGeometry x="920" y="300" width="140" height="50" as="geometry"/>
</mxCell>

<!-- Rollback Steps (Critical Path) -->
<mxCell id="rb-step1" value="Step 1: Stop New\nVersion Container\n(docker compose down)" style="rounded=1;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=11;" vertex="1" parent="1">
<mxGeometry x="40" y="380" width="160" height="50" as="geometry"/>
</mxCell>

<mxCell id="rb-step2a" value="Step 2a: Rollback\nSQLite Engine Store\n(cp backup → .code-intel)" style="rounded=1;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontColor=#4a148c;fontSize=11;" vertex="1" parent="1">
<mxGeometry x="260" y="380" width="160" height="50" as="geometry"/>
</mxCell>

<mxCell id="rb-step2b" value="Step 2b: Rollback\nPostgreSQL Migration\n(Execute rollback SQL\nfrom §4.4)" style="rounded=1;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontColor=#4a148c;fontSize=11;" vertex="1" parent="1">
<mxGeometry x="260" y="450" width="160" height="55" as="geometry"/>
</mxCell>

<mxCell id="rb-step3" value="Step 3: Deploy\nPrevious Version\n(docker compose up -d\nwith prev image tag)" style="rounded=1;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=11;" vertex="1" parent="1">
<mxGeometry x="40" y="450" width="160" height="55" as="geometry"/>
</mxCell>

<mxCell id="rb-step4" value="Step 4: Restore\nConfiguration\n(Revert env vars,\nfeature flags)" style="rounded=1;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=11;" vertex="1" parent="1">
<mxGeometry x="40" y="530" width="160" height="50" as="geometry"/>
</mxCell>

<mxCell id="rb-step5" value="Step 5: Verify\nRollback Success\n(Health checks + Smoke\ntests from §7.1-7.2)" style="rounded=1;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontColor=#e65100;fontSize=11;" vertex="1" parent="1">
<mxGeometry x="700" y="380" width="160" height="60" as="geometry"/>
</mxCell>

<!-- Verification Decision -->
<mxCell id="rb-verify" value="Rollback\nVerified?" style="rhombus;html=1;fillColor=#ffeb3b;strokeColor=#f57f17;fontColor=#f57f17;fontSize=11;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="700" y="470" width="120" height="60" as="geometry"/>
</mxCell>

<mxCell id="rb-success" value="✅ Rollback\nSUCCESSFUL\n- System stable\n- Notify stakeholders\n- Create incident report" style="ellipse;html=1;fillColor=#4caf50;strokeColor=#2e7d32;fontColor=white;fontSize=11;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="700" y="560" width="160" height="60" as="geometry"/>
</mxCell>

<mxCell id="rb-fail" value="❌ Rollback\nFAILED\n- Escalate to DBA\n- Emergency procedures\n- Consider DR plan" style="ellipse;html=1;fillColor=#f44336;strokeColor=#c62828;fontColor=white;fontSize=11;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="920" y="470" width="160" height="60" as="geometry"/>
</mxCell>

<!-- Communication -->

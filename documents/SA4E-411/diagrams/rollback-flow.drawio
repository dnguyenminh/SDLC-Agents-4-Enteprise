<mxGeometry x="480" y="650" width="160" height="70" as="geometry"/>
</mxCell>

<!-- Time Estimate Box -->
<mxCell id="timebox" value="⏱ Rollback Time Estimate (§8.4):\n• Stop container: 30s\n• DB rollback (SQLite + PG): 5 min\n• Deploy prev version: 2 min\n• Config restore: 1 min\n• Verification: 5 min\n─────────────────\nTotal: ~13 minutes" style="rounded=1;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontColor=#424242;fontSize=10;" vertex="1" parent="1">
<mxGeometry x="20" y="690" width="300" height="150" as="geometry"/>
</mxCell>

<!-- Decision Criteria Box -->
<mxCell id="criteriabox" value="📋 Rollback Decision Criteria (§8.2):\n✅ IMMEDIATE: Critical defect, perf >50%,\ndata integrity, MCP spawn failure\n✅ HOTFIX: Minor UI, workaround exists\n✅ WAIT: Unclear impact, need PM decision\n❌ NO ROLLBACK: Cosmetic only" style="rounded=1;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontColor=#424242;fontSize=10;" vertex="1" parent="1">
<mxGeometry x="340" y="690" width="300" height="150" as="geometry"/>
</mxCell>

<!-- SA4E-335 Warning -->
<mxCell id="warning" value="⚠️ SA4E-335 DOCKER VOLUME PROTECTION:\nNEVER run 'docker compose down -v' on prod stack!\n• Use 'docker compose down' (no -v) to keep volumes\n• Test stack separate: docker-compose.test.yml (project sa4e-test)\n• Backup: npm run db:backup (pg_dump daily 02:00)\n• SQLite: copy .code-intel/index.db + WAL files" style="rounded=1;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontColor=#c62828;fontSize=10;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="660" y="690" width="440" height="120" as="geometry"/>

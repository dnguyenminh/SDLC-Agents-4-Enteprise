    <mxCell id="gb-1" value="• runtime-tokenizer.ts — injectable fetchFn → llama.cpp /tokenize&#xa;• budget-gate.ts — resolveContextBudget + tryRuntimeTokenCount + runSessionBudgetGate&#xa;• scratchpad.ts — canonical format parser &amp; emitter&#xa;• eviction.ts — S_evict calculator + batchEvict + tombstone logic&#xa;• token-eviction.integration.test.ts — 13 backend + 9 extension tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="boundary-gate-backend">

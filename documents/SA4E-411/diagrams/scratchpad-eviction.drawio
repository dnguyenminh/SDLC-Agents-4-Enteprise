    <mxCell id="goal" value="• Goal: [1-sentence objective]&#xa;  e.g., &quot;Find the auth handler for JWT validation&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#333333;" vertex="1" parent="scratchpad-root">
      <mxGeometry x="10" y="20" width="520" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="deadends" value="• DeadEnds: [file:lines → brief reason not relevant]&#xa;  e.g., &quot;src/auth.ts:10-50 → only exports types, no logic&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#666666;" vertex="1" parent="scratchpad-root">

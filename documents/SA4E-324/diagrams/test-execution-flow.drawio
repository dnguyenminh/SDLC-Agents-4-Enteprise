<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="SA4E-324 Test Execution Flow — PBT → UT → IT → E2E-API → E2E-UI → SIT (fail → fix → retest loops, merge gate on 3 Highs)" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="s" value="START: BRD + FSD v1.2 + TDD v1.1 + SEC-REVIEW + CSV fixtures ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="55" width="380" height="50" as="geometry"/></mxCell><mxCell id="pbt" value="PBT (fast-check) 6 props — order/length, fallback, monotonic, invariants, partitioning, clamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="135" width="180" height="70" as="geometry"/></mxCell><mxCell id="ut" value="UT (vitest) 28 units — registry, budget, mapper throw, fallback, cache, smollm2, grep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="135" width="180" height="70" as="geometry"/></mxCell><mxCell id="it" value="IT (fetch mock) 20 — 4 contracts, batch, fallback, window, gate goldens, SEC-01/02/03" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="135" width="180" height="70" as="geometry"/></mxCell><mxCell id="eapi" value="E2E-API (real mock server) 12 — gate REJECT/WARN/ALLOW, auth, SEC E2E" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="690" y="135" width="160" height="70" as="geometry"/></mxCell><mxCell id="eui" value="E2E-UI (Playwright) 8 — % bar, colors, toasts, switch, sanitize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="270" y="250" width="180" height="70" as="geometry"/></mxCell><mxCell id="sit" value="SIT (manual) 6 — overlay, layout, VI corpus, drift, hostile, injection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="180" height="70" as="geometry"/></mxCell><mxCell id="gate" value="MERGE GATE: 0 Critical + 0 SEC-High open + grep 0 primaries + NFR p95 met + RTM 100%?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="690" y="240" width="200" height="90" as="geometry"/></mxCell><mxCell id="done" value="DONE: 80/80 executed + evidence/ + TEST-REPORT.csv + KB ingest (STP/STC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="380" height="50" as="geometry"/></mxCell><mxCell id="fix" value="FIX + RETEST (DEV fixes prod code only; QA re-runs level)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="180" height="70" as="geometry"/></mxCell><mxCell id="e0" edge="1" parent="1" source="s" target="pbt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" source="pbt" target="ut" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" edge="1" parent="1" source="ut" target="it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" edge="1" parent="1" source="it" target="eapi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" edge="1" parent="1" source="eapi" target="eui" style="edgeStyle=or
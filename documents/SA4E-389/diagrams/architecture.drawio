    <mxCell id="title" value="Layered Architecture — Multi LLM Configuration Profiles (SA4E-389)" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="180" y="10" width="620" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="noteRules" value="Layering rules:&lt;br&gt;• Dependencies point DOWNWARD only&lt;br&gt;• Webviews never touch storage directly&lt;br&gt;• All provider/model/baseUrl reads go through readProviderTurnConfig() (SSOT) — no flat key reads&lt;br&gt;• All API key access goes through llmSecretKey(id)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="880" y="60" width="320" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="legend" value="Legend:&#10;&#9633; blue = UI / actor&#10;&#9633; orange = process / service&#10;&#9633; green = storage (cylinder)&#10;&#9633; red = error / decision" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">

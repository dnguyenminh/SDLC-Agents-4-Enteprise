<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="start" value="User clicks Sign in with Provider" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="step1" value="sso-dynamic /{provider}/login → buildAuthorizeUrl" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="step2" value="Redirect to Identity Provider authorize URL (PKCE/state/nonce)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="250" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="step3" value="User authenticates at IdP" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="350" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="step4" value="IdP redirects back with code + state" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="450" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="step5" value="Strategy.handleCallback: exchange code, verify token / userinfo, normalize to NormalizedProfile" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="550" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="step6" value="JitProvisioningService.provision(NormalizedProfile) → check external identity / email → create / link / update last_login" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="670" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="end" value="Return SSO session to user" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="200" y="800" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="e1" edge="1" parent="1" source="start" target="step1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>

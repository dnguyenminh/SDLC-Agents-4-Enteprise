<mxGraphModel adaptiveColors="auto"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Wrapper-mode contract: bytes or a hard error &amp;mdash; never a bare path" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1600" height="30" as="geometry"/></mxCell>
<mxCell id="laneLLM" value="LLM / Agent" style="swimlane;horizontal=0;startSize=110;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1600" height="250" as="geometry"/></mxCell>
<mxCell id="laneWrapper" value="Extension Wrapper" style="swimlane;horizontal=0;startSize=110;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1600" height="340" as="geometry"/></mxCell>
<mxCell id="laneBackend" value="Backend Orchestration (Content Proxy)" style="swimlane;horizontal=0;startSize=110;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="1600" height="520" as="geometry"/></mxCell>
<mxCell id="laneChild" value="Child MCP Server" style="swimlane;horizontal=0;startSize=110;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1600" height="170" as="geometry"/></mxCell>
<mxCell id="A1" value="Agent calls execute_dynamic_tool(toolName=export_*, file_path, output_path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="laneLLM"><mxGeometry x="120" y="30" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="A2" value="Agent receives the written file: file_path + size_bytes (never a bare host path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="laneLLM"><mxGeometry x="1020" y="40" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="A3" value="Agent receives a hard error and knows no file was written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="laneLLM"><mxGeometry x="1200" y="140" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="P1" value="Resolve file_path and read file bytes (workspace path guard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="laneWrapper"><mxGeometry x="120" y="40" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="P2" value="Send content_base64 + output_path to the backend (wrapper-only args)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="laneWrapper"><mxGeometry x="300" y="40" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="P3" value="Write every artifact to output_path and verify the written count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="laneWrapper"><mxGeometry x="1020" y="40" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="P4" value="Fail loud: no file written (PROXY_WRITE_FAILED or error passthrough)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="laneWrapper"><mxGeometry x="1200" y="200" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="B1" value="Detect capability and adapt schema: x-content-param, x-output-base64, required: []" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="laneBackend"><mxGeometry x="480" y="40" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="B2" value="Decode content_base64 (strict UTF-8) into the child content arg; strip wrapper args" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="laneBackend"><mxGeometry x="660" y="40" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="B3" value="Retrieve artifact bytes: inline / MCP resource / URL / data URI / local file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="laneBackend"><mxGeometry x="840" y="190" width="170" height="90" as="geometry"/></mxCell>

</mxCell>

<mxCell id="lane_bridge" value="Extension MCP Bridge" style="swimlane;horizontal=0;startSize=110;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=12;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="40" y="180" width="4552" height="180" as="geometry"/>
</mxCell>

<mxCell id="lane_engine" value="Draw.io Engine" style="swimlane;horizontal=0;startSize=110;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="40" y="360" width="4552" height="276" as="geometry"/>
</mxCell>

<mxCell id="lane_elk" value="ELK.js Layout Engine" style="swimlane;horizontal=0;startSize=110;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=12;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="40" y="636" width="4552" height="180" as="geometry"/>
</mxCell>

<mxCell id="lane_fs" value="File System" style="swimlane;horizontal=0;startSize=110;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="40" y="816" width="4552" height="140" as="geometry"/>
</mxCell>

<mxCell id="lane_renderer" value="PNG Renderer" style="swimlane;horizontal=0;startSize=110;fillColor=#e0f2f1;strokeColor=#00695c;fontSize=12;fontStyle=1;" vertex="1" parent="1">
<mxGeometry x="40" y="956" width="4552" height="140" as="geometry"/>
</mxCell>

<!-- Start -->
<mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
<mxGeometry x="192" y="100" width="20" height="20" as="geometry"/>
</mxCell>

<!-- AI Agent Steps -->
<mxCell id="s1" value="1. Generate/modify&#10;.drawio XML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="lane_ai">
<mxGeometry x="222" y="45" width="140" height="50" as="geometry"/>
</mxCell>

<mxCell id="s2" value="2. Call drawio_auto_layout&#10;(file_path, base_dir, mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="lane_ai">

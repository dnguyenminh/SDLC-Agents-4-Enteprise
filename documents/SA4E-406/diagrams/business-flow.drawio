<mxGraphModel adaptiveColors="auto">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>

<!-- Swimlanes -->
<mxCell id="lane_ai" value="AI Agent" style="swimlane;horizontal=0;startSize=110;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;fontStyle=1;" vertex="1" parent="1">

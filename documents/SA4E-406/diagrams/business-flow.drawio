</mxCell>

<mxCell id="s11" value="11. Call drawio_export_png" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="lane_ai">
<mxGeometry x="3362" y="45" width="140" height="50" as="geometry"/>
</mxCell>

<mxCell id="s12" value="12. Embed PNG in document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="lane_ai">
<mxGeometry x="4312" y="45" width="140" height="50" as="geometry"/>
</mxCell>

<!-- Bridge Steps -->
<mxCell id="s3" value="3. Validate base_dir&#10;against allowlist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="lane_bridge">
<mxGeometry x="602" y="45" width="140" height="50" as="geometry"/>
</mxCell>

<mxCell id="s4" value="4. Resolve absolute path&#10;(base_dir + file_path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="lane_bridge">
<mxGeometry x="792" y="45" width="140" height="50" as="geometry"/>
</mxCell>

<mxCell id="s5" value="5. Path traversal check&#10;(CWE-22 prevention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;" vertex="1" parent="lane_bridge">
<mxGeometry x="982" y="45" width="140" height="50" as="geometry"/>
</mxCell>

<mxCell id="s6" value="6. Route to engine via&#10;execute_dynamic_tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="lane_bridge">
<mxGeometry x="1172" y="45" width="140" height="50" as="geometry"/>
</mxCell>

<!-- Engine Steps -->
<mxCell id="s7" value="7. Parse XML to&#10;DiagramGraph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=11;" vertex="1" parent="lane_engine">
<mxGeometry x="1362" y="50" width="160" height="50" as="geometry"/>
</mxCell>

<mxCell id="s8" value="8. Enhanced Detection&#10;(5% overlap, 40px gap,&#10;crossings, diagonals)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=11;" vertex="1" parent="lane_engine">
<mxGeometry x="1572" y="40" width="160" height="70" as="geometry"/>
</mxCell>

<mxCell id="dec1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontSize=11;" vertex="1" parent="lane_engine">

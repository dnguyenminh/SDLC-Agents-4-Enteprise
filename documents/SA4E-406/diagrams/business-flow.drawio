</mxCell>

<mxCell id="s9a" value="9a. Return needs_fix&#10;(mode=review)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=11;" vertex="1" parent="lane_engine">
<mxGeometry x="1912" y="50" width="160" height="50" as="geometry"/>
</mxCell>

<mxCell id="s9b" value="9b. Verify Loop Start&#10;(mode=apply, max 3 iter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontSize=11;" vertex="1" parent="lane_engine">
<mxGeometry x="1912" y="173.5" width="160" height="55" as="geometry"/>
</mxCell>

<mxCell id="s10" value="10. Call ELK Compound Layout&#10;(layered/stress/force/radial)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=11;" vertex="1" parent="lane_engine">
<mxGeometry x="2122" y="47.5" width="160" height="55" as="geometry"/>

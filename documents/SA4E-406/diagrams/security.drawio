        <mxCell id="note1" value="Test Cases That Must Pass:&#xa;✓ file_path=\"..\\..\\etc\\passwd\" → rejected&#xa;✓ file_path=\"C:\\Windows\\System32\" → rejected&#xa;✓ file_path=\"diagrams\\0secret.txt\" → rejected&#xa;✓ Symlink pointing outside workspace → rejected&#xa;✓ Win32: C:\\Project vs c:\\project → match&#xa;✓ Valid relative path within base_dir → accepted&#xa;✓ Generic error: no path details in response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontSize=10;" vertex="1" parent="1">

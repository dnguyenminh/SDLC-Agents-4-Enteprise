        <mxCell id="note1" value="ELK Algorithms:&#xa;• layered: org.eclipse.elk.layered (default)&#xa;• stress: org.eclipse.elk.stress (NEW)&#xa;• force: org.eclipse.elk.force&#xa;• radial: org.eclipse.elk.radial&#xa;&#xa;Container padding: [top=40,left=20,bottom=20,right=20]&#xa;Inner spacing: max(spacing*0.6, 30)&#xa;Edge routing: ORTHOGONAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1514.2" y="40" width="220" height="180" as="geometry"/></mxCell>
        <mxCell id="note2" value="ELK Layout Options:&#xa;• elk.algorithm: mapped from args&#xa;• elk.direction: args.direction&#xa;• elk.spacing.nodeNode: args.spacing&#xa;• elk.layered.spacing.nodeNodeBetweenLayers: spacing*2&#xa;• elk.edgeRouting: ORTHOGONAL&#xa;• elk.layered.spacing.edgeNodeBetweenLayers: 20&#xa;• elk.layered.spacing.edgeEdgeBetweenLayers: 20&#xa;• elk.layered.nodePlacement.strategy: BRANDES_KOEPF&#xa;• elk.hierarchyHandling: INCLUDE_CHILDREN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#6a1b9a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1514.2" y="240" width="240" height="220" as="geometry"/></mxCell>
        <mxCell id="note3" value="Compound Node Support:&#xa;• Containers mapped to ElkNode with children[]&#xa;• Single algorithm drives entire hierarchy&#xa;• Container resized to encompass children + margin&#xa;• Nested containers supported&#xa;• Cross-container edges at root level&#xa;• Internal edges within container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1514.2" y="480" width="220" height="180" as="geometry"/></mxCell>

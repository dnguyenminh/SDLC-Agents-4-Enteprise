    <!-- Note about backup channel -->
    <mxCell id="note1" value="Backup / defense-in-depth: BasePanel also posts token_refreshed right after&#10;panel creation. SPA listener (see refresh flow) writes admin_token even if&#10;URL bootstrap is skipped. Both paths converge on localStorage.admin_token." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">

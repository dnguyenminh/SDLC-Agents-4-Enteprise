<mxGraphModel dx="1184" dy="770" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- Title -->
    <mxCell id="title" value="Business Flow — SA4E-372 Chatbox UX/Persistence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#303F9F;fontSize=16;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="1100" height="50" as="geometry"/>
    </mxCell>
    
    <!-- Steps -->
    <mxCell id="s1" value="1. User opens chatbox panel&#xa;(webview loads)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="90" width="200" height="55" as="geometry"/>
    </mxCell>
    
    <mxCell id="s2" value="2. System checks workspace storage&#xa;for existing transcript&#xa;(chat:chatHistory protocol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="160" width="200" height="60" as="geometry"/>
    </mxCell>
    
    <mxCell id="s3a" value="3a. Transcript exists →&#xa;Deserialize & render all messages&#xa;with original block structure,&#xa;thinking blocks, tool-call groups,&#xa;and collapse states" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="250" y="160" width="250" height="80" as="geometry"/>
    </mxCell>
    
    <mxCell id="s3b" value="3b. No transcript →&#xa;Render empty chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#BF360C;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="520" y="160" width="200" height="55" as="geometry"/>
    </mxCell>
    
    <mxCell id="s4" value="4. User sends message&#xa;(text or @mention command)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="240" width="200" height="55" as="geometry"/>
    </mxCell>
    
    <mxCell id="s5" value="5. System renders user message&#xa;bubble immediately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="310" width="200" height="55" as="geometry"/>
    </mxCell>
    
    <mxCell id="s6" value="6. AI agent turn begins —&#xa;may consist of N sequential&#xa;think-act loops (N ≥ 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="380" width="200" height="60" as="geometry"/>
    </mxCell>
    
    <!-- Loop -->
    <mxCell id="loop-start" value="7. LOOP START&#xa;AI emits thinking →&#xa;System creates NEW Thinking Block&#xa;(distinct from previous loops)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="250" y="380" width="250" height="65" as="geometry"/>
    </mxCell>
    
    <mxCell id="loop-continue" value="8. LOOP CONTINUE&#xa;AI calls tool(s) →&#xa;System creates NEW Tool Call Group&#xa;associated with current thinking block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="520" y="380" width="250" height="65" as="geometry"/>
    </mxCell>
    
    <mxCell id="loop-stream" value="9. Tool results stream in →&#xa;System updates Tool Call Group&#xa;in real-time (NO auto-collapse&#xa;during streaming — R2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="790" y="380" width="250" height="65" as="geometry"/>
    </mxCell>
    
    <mxCell id="loop-auto" value="10. ALL tools complete →&#xa;System AUTO-COLLAPSES Tool Call Group&#xa;(default) unless user previously&#xa;expanded it (sticky — R2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="250" y="460" width="250" height="65" as="geometry"/>
    </mxCell>
    
    <mxCell id="loop-decision" value="11. More loops?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="520" y="460" width="120" height="65" as="geometry"/>
    </mxCell>
    
    <mxCell id="loop-end" value="12. AI emits final answer →&#xa;System renders Answer Block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="660" y="460" width="250" height="55" as="geometry"/>
    </mxCell>
    
    <mxCell id="s13" value="13. Complete turn persisted to&#xa;workspace storage atomically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="540" width="200" height="55" as="geometry"/>
    </mxCell>
    
    <mxCell id="s14" value="14. User may expand/collapse&#xa;any block → preference saved&#xa;per-block-ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="610" width="200" height="55" as="geometry"/>
    </mxCell>
    
    <mxCell id="s15" value="15. User closes panel / reloads VS Code →&#xa;Step 2 on next open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="680" width="200" height="55" as="geometry"/>
    </mxCell>
    
    <!-- Edges -->

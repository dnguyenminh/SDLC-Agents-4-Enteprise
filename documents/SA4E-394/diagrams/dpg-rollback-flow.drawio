<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="start" value="Issue detected post-deployment —&#10;health fail · rejection spike · smoke fail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="40" width="280" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="d1" value="Assess cause&#10;and severity" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="340" y="140" width="260" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="minor" value="Minor (schema text / typo) →&#10;hotfix, no rollback —&#10;report to SM/PO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="40" y="155" width="230" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="cfg1" value="Config rollback — remove&#10;MCP_WORKSPACE_ROOTS +&#10;MCP_WORKSPACE_ROOTS_FILE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="60" y="300" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="cfg2" value="Restart backend (standalone)&#10;· reload extension host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="60" y="410" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="cfg3" value="Verify INFO log —&#10;&quot;legacy single-root mode active&quot; (BR-16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="60" y="520" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="code1" value="Code rollback —&#10;git revert release commit(s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="620" y="300" width="280" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="code2" value="Rebuild + restart —&#10;npm run build &amp;&amp; npm start&#10;extension: reinstall prior bundle + Reload Window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="620" y="410" width="280" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="code3" value="Verify — GET /health 200 +&#10;legacy smoke V4 passes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="620" y="520" width="280" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="d2" value="Rollback verified?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="340" y="650" width="260" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="ok" value="Rollback complete — stable legacy mode;&#10;schedule root-cause fix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="800" width="340" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="esc" value="Escalate — restore last good git tag +&#10;prior extension bundle; incident review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="700" y="800" width="300" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="note" value="No database rollback required —&#10;feature has no DB changes (TDD §4.1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="660" width="240" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="rb1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="d1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="rb2" value="Minor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;fontColor=#2d7600;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="minor">
      <mxGeometry relative="1" as="geometry"/>

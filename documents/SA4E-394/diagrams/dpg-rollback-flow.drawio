    <mxCell id="rb3" value="Allowlist / config issue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;fontColor=#ae4132;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="cfg1">
      <mxGeometry relative="1" as="geometry"/>

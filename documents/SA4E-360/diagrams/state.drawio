    </mxCell>
    <mxCell id="degraded" value="DEGRADED_NO_SKELETON&#10;agentic fallback: get_workspace_info + read_method steering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="330" y="250" width="200" height="80" as="geometry" />

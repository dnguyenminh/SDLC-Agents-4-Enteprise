    </mxCell>
    <mxCell id="truncating" value="TRUNCATING&#10;module-priority truncation (ModuleSummarizer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="810" y="240" width="180" height="70" as="geometry" />
    </mxCell>
    <mxCell id="injected" value="INJECTED&#10;createHost override — session created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d5;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="1060" y="90" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="active" value="SESSION_ACTIVE&#10;skeleton static; read_method slices grow transcript — absorbed by gate #3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d5;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="1060" y="240" width="190" height="80" as="geometry" />
    </mxCell>

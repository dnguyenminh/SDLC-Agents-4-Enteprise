    </mxCell>
    <mxCell id="note1" value="Per-file SKIPPED (extraction error / unreadable) never blocks the session — skip + log + continue (BR-360-03)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1">

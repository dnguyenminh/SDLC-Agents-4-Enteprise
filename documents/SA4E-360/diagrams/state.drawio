    </mxCell>
    <mxCell id="building" value="BUILDING&#10;extractOutline per file (+ regex fallback / RAW_HEAD / SKIPPED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d5;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="320" y="85" width="190" height="70" as="geometry" />

    <mxCell id="title" value="SA4E-365 — State Machine: ThinkingBlock per streamId (điều khiển bởi thinkingActive — FSD §6.4 + INV-1..INV-5)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="250" y="15" width="900" height="30" as="geometry"></mxGeometry>

    <mxCell id="e1" value="chunk 'thinking' đầu tiên&#10;[!thinkingActive.has(streamId)]&#10;/ THINKING_START + add(streamId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="s_idle" target="s_live">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

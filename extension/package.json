{
  "name": "sdlc-agents-4-enterprise",
  "displayName": "SDLC Agents 4 Enterprise",
  "description": "Multi-agent SDLC pipeline for enterprise — 9 AI agents (SM, BA, TA, SA, QA, DEV, DevOps, Security, UI) orchestrated via MCP",
  "version": "1.47.0",
  "publisher": "dnguyenminh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnguyenminh/SDLC-Agents-4-Enteprise"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": [
        "sdlcAgents.backend.allowInsecureRemote",
        "sdlcAgents.backend.url",
        "sdlcAgents.pegaEndpoint",
        "sdlcAgents.pegaUsername",
        "sdlcAgents.atlassianConnectionType",
        "sdlcAgents.anthropicBaseUrl",
        "sdlcAgents.openaiBaseUrl",
        "sdlcAgents.ollamaUrl",
        "sdlcAgents.lmstudioBaseUrl"
      ]
    }
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "kiro",
    "sdlc",
    "agents",
    "multi-agent",
    "BA",
    "QA",
    "DevOps",
    "scrum",
    "mcp"
  ],
  "activationEvents": [
    "onView:sdlcAgentsTree",
    "onView:sdlcChatPanel",
    "onCommand:sdlcAgents.injectAll",
    "onCommand:sdlcAgents.status",
    "onCommand:sdlcAgents.openSettings",
    "onCommand:sdlcAgents.openPegaIngester"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sdlcAgents.injectAll",
        "title": "SDLC Agents: Inject All Agents",
        "icon": "$(cloud-download)"
      },
      {
        "command": "sdlcAgents.injectSelective",
        "title": "SDLC Agents: Inject (Select Components)"
      },
      {
        "command": "sdlcAgents.update",
        "title": "SDLC Agents: Update Agents"
      },
      {
        "command": "sdlcAgents.status",
        "title": "SDLC Agents: Show Status",
        "icon": "$(info)"
      },
      {
        "command": "sdlcAgents.openKbGraph",
        "title": "SDLC Agents: Open KB Graph"
      },
      {
        "command": "sdlcAgents.openKbDashboard",
        "title": "SDLC Agents: Open KB Dashboard"
      },
      {
        "command": "sdlcAgents.openKbTags",
        "title": "SDLC Agents: Open KB Tags"
      },
      {
        "command": "sdlcAgents.openKbQuality",
        "title": "SDLC Agents: Open KB Quality"
      },
      {
        "command": "sdlcAgents.openKbAnalytics",
        "title": "SDLC Agents: Open KB Analytics"
      },
      {
        "command": "sa4e.retryFailedEnrichment",
        "title": "SDLC Agents: Retry Failed Enrichment"
      },
      {
        "command": "sa4e.showEnrichmentStatus",
        "title": "SDLC Agents: Show Enrichment Status"
      },
      {
        "command": "sdlcAgents.showIndexStatus",
        "title": "SDLC Agents: Show KB Ingest Status"
      },
      {
        "command": "sdlcAgents.symbolSearch",
        "title": "SDLC Agents: Symbol Search"
      },
      {
        "command": "sdlcAgents.openSecurityPanel",
        "title": "SDLC Agents: Security Panel"
      },
      {
        "command": "sdlcAgents.impactAnalysis",
        "title": "SDLC Agents: Impact Analysis"
      },
      {
        "command": "sdlcAgents.openPlanCanvas",
        "title": "SDLC Agents: Open Plan Canvas"
      },
      {
        "command": "sdlcAgents.getAIContext",
        "title": "SDLC Agents: Get AI Context for Symbol"
      },
      {
        "command": "sdlcAgents.getEditContext",
        "title": "SDLC Agents: Get Edit Context for Symbol"
      },
      {
        "command": "sdlcAgents.openSettings",
        "title": "SDLC Agents: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "sdlcAgents.openKbBrowser",
        "title": "SDLC Agents: Open KB in Browser"
      },
      {
        "command": "sdlcAgents.login",
        "title": "SDLC Agents: Login to Backend"
      },
      {
        "command": "sdlcAgents.logout",
        "title": "SDLC Agents: Logout"
      },
      {
        "command": "sdlcAgents.reconnect",
        "title": "SDLC Agents: Reconnect to Backend"
      },
      {
        "command": "sdlcAgents.disconnect",
        "title": "SDLC Agents: Disconnect"
      },
      {
        "command": "sdlcAgents.indexDocuments",
        "title": "SDLC Agents: Index Documents"
      },
      {
        "command": "sdlcAgents.indexSource",
        "title": "SDLC Agents: Index Source Code"
      },
      {
        "command": "sdlcAgents.syncWorkspace",
        "title": "SDLC Agents: Sync Workspace"
      },
      {
        "command": "sdlcAgents.fetchPegaContext",
        "title": "SDLC Agents: Fetch Pega App Context"
      },
      {
        "command": "sdlcAgents.openAgenticChat",
        "title": "SDLC Agents: Open Agentic Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sdlcAgents.openPegaIngester",
        "title": "SDLC Agents: Open Pega Ingester"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sdlcAgents",
          "title": "SDLC Agents 4 Enterprise",
          "icon": "resources/activity-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "sdlcChatContainer",
          "title": "SDLC Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "sdlcAgents": [
        {
          "id": "sdlcAgentsTree",
          "name": "SDLC Agents"
        }
      ],
      "sdlcChatContainer": [
        {
          "id": "sdlcChatPanel",
          "name": "Chat Panel",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "SDLC Agents 4 Enterprise",
      "properties": {
        "sdlcAgents.backend.url": {
          "type": "string",
          "default": "http://127.0.0.1:48721",
          "description": "Remote Kiro backend server URL"
        },
        "sdlcAgents.backend.allowInsecureRemote": {
          "type": "boolean",
          "default": false,
          "description": "Bypass the HTTPS requirement for remote (non-loopback) backend server URLs. When enabled, HTTP remote URLs are accepted but traffic is unencrypted — credentials and data can be intercepted. Only enable on trusted private networks."
        },
        "sdlcAgents.backend.ssoEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable SSO/PKCE authentication"
        },
        "sdlcAgents.backend.ssoProviderUrl": {
          "type": "string",
          "default": "",
          "description": "OAuth2 SSO provider URL for PKCE flow"
        },
        "sdlcAgents.backend.toolCallTimeout": {
          "type": "number",
          "default": 300000,
          "description": "Timeout for MCP tool calls (ms)"
        },
        "sdlcAgents.backend.chatTimeout": {
          "type": "number",
          "default": 0,
          "description": "Wall-clock timeout for a chat turn (ms). 0 = DISABLED (default): a turn is never stopped by elapsed time — it stops only when a tool/failure/response repeats (loop guard). Set a positive value to opt into a wall-clock backstop."
        },
        "sdlcAgents.turn.maxToolRepeats": {
          "type": "number",
          "default": 4,
          "minimum": 2,
          "maximum": 20,
          "description": "Stop a chat turn when one identical tool call (same tool + arguments) repeats this many times — loop guard. No total call cap is enforced."
        },
        "sdlcAgents.backend.healthCheckInterval": {
          "type": "number",
          "default": 30000,
          "description": "Health check interval (ms)"
        },
        "sdlcAgents.backend.rateLimitRpm": {
          "type": "number",
          "default": 6000,
          "minimum": 1,
          "description": "Requests-per-minute this client asks the backend to allow. The server clamps this to its own hard cap (configured in the web admin); you can lower it but never exceed the server maximum."
        },
        "sdlcAgents.pega.dedupMaxInMemory": {
          "type": "number",
          "default": 100000,
          "minimum": 1,
          "description": "Max Pega rule dedup keys kept in memory during indexing. When exceeded, keys spill to a temporary disk file (deleted after the run) so RAM stays bounded on large rulebases. Lower this on memory-constrained machines."
        },
        "sdlcAgents.pega.fetchBatchSize": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Pega indexing: number of rules the supplier pulls off the queue and fetches per batch. Larger batches reduce per-batch overhead but hold more rules in flight. Takes effect on the next indexing run."
        },
        "sdlcAgents.pega.ingestConcurrency": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 64,
          "description": "Pega indexing: max concurrent ingest requests to the backend. Higher values speed up indexing when the network is the bottleneck, but increase load on the shared backend. Takes effect on the next indexing run."
        },
        "sdlcAgents.pega.ingestChannelCapacity": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 512,
          "description": "Pega indexing: buffer size between the fetch supplier and ingest consumers (backpressure). 0 = auto (2× ingest concurrency). Raise to let the supplier run further ahead at the cost of more buffered rules in RAM. Takes effect on the next indexing run."
        },
        "sdlcAgents.mcpServerPort": {
          "type": "number",
          "default": 9181,
          "description": "Local MCP wrapper server port — the in-process HTTP server that the IDE connects to"
        },
        "sdlcAgents.enableMcpServer": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the local MCP wrapper server on startup"
        },
        "sdlcAgents.mcpServerUrl": {
          "type": "string",
          "default": "",
          "description": "Override URL for the local MCP wrapper server (leave empty to use mcpServerPort)"
        },
        "sdlcAgents.configPath": {
          "type": "string",
          "default": ".code-intel/orchestration.json",
          "description": "Path to orchestration config file (relative to workspace root)"
        },
        "sdlcAgents.llmProvider": {
          "type": "string",
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openai",
            "ollama",
            "lmstudio",
            "openrouter",
            "onnx",
            "kiro"
          ],
          "description": "Active LLM provider"
        },
        "sdlcAgents.llmModel": {
          "type": "string",
          "default": "",
          "description": "Override model for the selected provider"
        },
        "sdlcAgents.llmFallbackModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Ordered list of fallback model ids the Pi chat retries on when the primary model fails with a transient gateway/upstream error (HTTP 5xx, timeout, or provider bootstrap failures like the Devin 'bridge sandbox' error). Tried in order after the primary; non-retryable errors (4xx/auth/bad request) do NOT trigger fallback. Example for an OmniRoute gateway: `[\"auto/best-coding\", \"agy/claude-sonnet-4-6\", \"auto/best-free\"]`."
        },
        "sdlcAgents.anthropicBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Custom base URL for Anthropic API (leave empty for official)"
        },
        "sdlcAgents.openaiBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Custom base URL for OpenAI API"
        },
        "sdlcAgents.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL"
        },
        "sdlcAgents.lmstudioBaseUrl": {
          "type": "string",
          "default": "",
          "description": "LM Studio server URL (default: http://localhost:1234/v1)"
        },
        "sdlcAgents.openrouterBaseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenRouter API base URL"
        },
        "sdlcAgents.kiroModel": {
          "type": "string",
          "default": "auto",
          "description": "Kiro gateway model selection"
        },
        "sdlcAgents.pegaEndpoint": {
          "type": "string",
          "default": "http://localhost:8080/prweb",
          "description": "Pega Platform REST API Endpoint URL"
        },
        "sdlcAgents.pega.useCatalogExport": {
          "type": "boolean",
          "default": true,
          "description": "Use the Pega Rule Catalog Export API (fast, authoritative rule list) when indexing Pega source code. Disable to force the legacy BFS crawl."
        },
        "sdlcAgents.pegaUsername": {
          "type": "string",
          "default": "",
          "description": "Pega Operator ID (Username)"
        },
        "sdlcAgents.pegaDeveloperShortName": {
          "type": "string",
          "default": "",
          "description": "Pega developer short name — used for Pega branch naming (e.g. ssa_SA4E-58). Falls back to pegaUsername before @"
        },
        "sdlcAgents.atlassianConnectionType": {
          "type": "string",
          "enum": [
            "cloud",
            "server"
          ],
          "default": "cloud",
          "description": "Atlassian connection type: cloud (email + API token) or server (username + PAT)"
        },
        "sdlcAgents.jiraSyncState": {
          "type": "object",
          "default": {},
          "description": "Internal: Jira project sync state (last sync dates per project key)"
        },
        "sdlcAgents.jiraLastProject": {
          "type": "string",
          "default": "",
          "description": "Last selected Jira project key for indexing"
        },
        "sdlcAgents.jiraAttachmentChecksums": {
          "type": "object",
          "default": {},
          "description": "Internal: checksum cache for Jira attachment dedup (id+size per file)"
        },
        "sdlcAgents.proxy.mode": {
          "type": "string",
          "enum": [
            "none",
            "system",
            "manual",
            "curl",
            "powershell"
          ],
          "default": "system",
          "description": "Proxy mode: none (direct), system (auto-detect), manual (user-configured), curl (curl.exe subprocess for NTLM/EDR), powershell (Invoke-WebRequest with NTLM/SSO)",
          "enumDescriptions": [
            "Direct connection — no proxy",
            "Auto-detect via VS Code proxy settings (http.proxy, http.proxySupport, http.noProxy, env vars) with OS-native fallback",
            "Manual configuration — specify proxy host and port",
            "Curl subprocess — uses curl.exe with NTLM SSO for corporate EDR environments where node.exe is blocked",
            "PowerShell subprocess — uses Invoke-WebRequest with -ProxyUseDefaultCredentials for corporate NTLM/Kerberos SSO"
          ]
        },
        "sdlcAgents.proxy.host": {
          "type": "string",
          "default": "",
          "description": "Proxy server hostname or IP address (used when mode = manual)"
        },
        "sdlcAgents.proxy.port": {
          "type": "number",
          "default": 8080,
          "minimum": 1,
          "maximum": 65535,
          "description": "Proxy server port (used when mode = manual)"
        },
        "sdlcAgents.proxy.bypass": {
          "type": "string",
          "default": "localhost,127.0.0.1,::1",
          "description": "Comma-separated list of hosts that bypass the proxy. Supports wildcards (*.domain.com)"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "sdlcAgents.openAgenticChat",
          "when": "view == sdlcAgentsTree",
          "group": "navigation"
        },
        {
          "command": "sdlcAgents.injectAll",
          "when": "view == sdlcAgentsTree",
          "group": "navigation"
        },
        {
          "command": "sdlcAgents.openSettings",
          "when": "view == sdlcAgentsTree",
          "group": "navigation"
        },
        {
          "command": "sdlcAgents.status",
          "when": "view == sdlcAgentsTree",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "vscode:prepublish": "npm run esbuild-production && npm run copy-resources && npm run gen-checksums",
    "package:debug": "npm run esbuild && vsce package --no-dependencies",
    "package:prod": "npm run esbuild-production && vsce package --no-dependencies",
    "compile": "tsc -p ./",
    "esbuild": "node esbuild.js",
    "smoke:bundle": "node scripts/smoke-bundle/run-smoke.js",
    "esbuild-production": "node esbuild.js --production",
    "esbuild-watch": "node esbuild.js --watch",
    "watch": "tsc -watch -p ./",
    "copy-resources": "node scripts/copy-resources.js",
    "gen-checksums": "node scripts/gen-checksums.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest watch",
    "lint": "npx eslint src/",
    "lint:fix": "npx eslint src/ --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.0.0",
    "@types/sinon": "^17.0.3",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "0.28.2",
    "fast-check": "^4.9.0",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "mocha": "^10.7.3",
    "sinon": "^17.0.1",
    "svelte": "^5.56.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0",
    "uuid": "^14.0.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@cortexkit/aft-pi": "0.57.2",
    "@earendil-works/chord": "0.99.1",
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-codemode": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-mcp": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@juicesharp/rpiv-ask-user-question": "2.11.0",
    "@juicesharp/rpiv-todo": "2.11.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@puppeteer/browsers": "^3.2.3",
    "@types/ws": "^8.18.1",
    "@vscode/proxy-agent": "^0.43.0",
    "ajv": "^8.17.1",
    "billion-context-pi": "0.1.82",
    "chrome-devtools-frontend": "^1.0.1625079",
    "core-js": "^3.49.0",
    "debug": "^4.4.3",
    "diff": "^5.2.2",
    "pi-subagents": "^0.76.1",
    "pi-web-access": "0.33.0",
    "puppeteer-core": "^25.12.0",
    "semver": "^7.7.4",
    "typebox": "^1.1.38",
    "undici": "^6.21.0",
    "urlpattern-polyfill": "^10.1.0",
    "ws": "^8.21.1",
    "yargs": "^17.7.2"
  }
}

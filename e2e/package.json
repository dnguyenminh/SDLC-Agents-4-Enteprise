{
  "name": "@sa4e/e2e",
  "version": "1.47.0",
  "private": true,
  "description": "BDD E2E testing framework (SA4E-341) - WebdriverIO + wdio-vscode-service + Serenity/JS Screenplay for VSCode-based IDEs (Kiro/Antigravity/Kilo). Standalone package, NOT part of root npm workspaces (TDD 2.1).",
  "scripts": {
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:report": "start target\\site\\serenity\\index.html",
    "test:e2e:clean": "node -e \"require('node:fs').rmSync('target', { recursive: true, force: true })\"",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@serenity-js/assertions": "^3.48.2",
    "@serenity-js/console-reporter": "^3.48.2",
    "@serenity-js/core": "^3.48.2",
    "@serenity-js/cucumber": "^3.48.2",
    "@serenity-js/serenity-bdd": "^3.48.2",
    "@serenity-js/webdriverio": "^3.48.2",
    "@types/node": "^22.0.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "eslint": "^10.12.0",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.8",
    "wdio-vscode-service": "^8.0.0",
    "webdriverio": "^9.32.0"
  }
}

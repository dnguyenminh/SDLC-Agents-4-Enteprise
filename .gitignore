# Secrets / env (SA4E-241 — never commit real credentials)
.env
.env.*
!.env.example

# Docker secrets (SA4E-335 — never commit real credentials; keep only *.example templates)
backend/secrets/*
!backend/secrets/*.example
secrets/*
!secrets/*.example
# Non-secret production env template is tracked; real values git-ignored
/backend/.env.production
!/backend/.env.production.example


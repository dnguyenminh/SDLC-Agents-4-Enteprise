# dev server log (keep untracked)
/backend/dev-server.log
/backend/*.log

# Local code-intel state (per-machine config, db, caches — never commit)
/backend/.code-intel/
# ...but keep the example config template in the repo
!/backend/.code-intel/database.example.json

# Database dumps (npm run db:backup — retention handled by the script)
/backend/backups/

# Secrets / env (SA4E-241 — never commit real credentials)
.env
.env.*
!.env.example

# Docker secrets (SA4E-335 — never commit real credentials; keep only *.example templates)
backend/secrets/*
!backend/secrets/*.example
secrets/*
!secrets/*.example
# Non-secret production env template is tracked; real values git-ignored
/backend/.env.production
!/backend/.env.production.example

# MCP request scratch file (SA4E-241 HTTP JSON-RPC body-from-file)
documents/**/.mcp-req.json

/.roo/

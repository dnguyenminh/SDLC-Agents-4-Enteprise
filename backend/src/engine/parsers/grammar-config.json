{
  "languages": [
    {
      "id": "typescript",
      "extensions": [".ts", ".tsx"],
      "wasmPath": "grammars/tree-sitter-typescript.wasm",
      "parserModule": "./languages/typescript-parser.js"
    },
    {
      "id": "javascript",
      "extensions": [".js", ".jsx", ".mjs", ".cjs"],
      "wasmPath": "grammars/tree-sitter-javascript.wasm",
      "parserModule": "./languages/typescript-parser.js"
    },
    {
      "id": "python",
      "extensions": [".py", ".pyi"],
      "wasmPath": "grammars/tree-sitter-python.wasm",
      "parserModule": "./languages/python-parser.js"
    },
    {
      "id": "kotlin",
      "extensions": [".kt", ".kts"],
      "wasmPath": "grammars/tree-sitter-kotlin.wasm",
      "parserModule": "./languages/kotlin-parser.js"
    },
    {
      "id": "java",
      "extensions": [".java"],
      "wasmPath": "grammars/tree-sitter-java.wasm",
      "parserModule": "./languages/java-parser.js"
    },
    {
      "id": "go",
      "extensions": [".go"],
      "wasmPath": "grammars/tree-sitter-go.wasm",
      "parserModule": "./languages/go-parser.js"
    },
    {
      "id": "rust",
      "extensions": [".rs"],
      "wasmPath": "grammars/tree-sitter-rust.wasm",
      "parserModule": "./languages/rust-parser.js"
    },
    {
      "id": "apex",
      "extensions": [".cls", ".trigger", ".apex", ".soql"],
      "wasmPath": "grammars/tree-sitter-apex.wasm",
      "parserModule": "./languages/apex-parser.js"
    },
    {
      "id": "salesforce-meta",
      "extensions": [
        ".flow-meta.xml", ".object-meta.xml", ".field-meta.xml", ".js-meta.xml", ".component-meta.xml",
        ".flexipage-meta.xml", ".permissionset-meta.xml", ".profile-meta.xml", ".labels-meta.xml",
        ".tab-meta.xml", ".layout-meta.xml", ".report-meta.xml", ".dashboard-meta.xml",
        ".site-meta.xml", ".resource-meta.xml", ".email-meta.xml", ".testsuite-meta.xml"
      ],
      "wasmPath": null,
      "parserModule": "./languages/salesforce-meta-parser.js"
    },
    {
      "id": "visualforce",
      "extensions": [".page", ".component"],
      "wasmPath": null,
      "parserModule": "./languages/visualforce-parser.js"
    },
    {
      "id": "aura",
      "extensions": [".cmp", ".app", ".evt", ".intf", ".tokens"],
      "wasmPath": null,
      "parserModule": "./languages/aura-parser.js"
    },
    {
      "id": "pega",
      "extensions": [".pega"],
      "wasmPath": null,
      "parserModule": "./languages/pega-parser.js"
    },
    {
      "id": "lwc-html",
      "extensions": [".html"],
      "wasmPath": null,
      "parserModule": "./languages/lwc-html-parser.js"
    }
  ]
}

# TEMPLATE ONLY (SA4E-335) — non-secret production runtime defaults.
# Copy to backend/.env.production (git-ignored) and tune per environment.
# Secrets are provisioned via Docker secrets (*_FILE), NEVER here.

NODE_ENV=production
PORT=48721
DATABASE_ADAPTER=postgresql

# Published-port host interface (SEC-07). Keep loopback unless fronted by a proxy.
PUBLISH_HOST=127.0.0.1

# Resource limits (compose env-substitution; tune per environment).
BACKEND_CPU_LIMIT=1.0
BACKEND_MEM_LIMIT=1g
PG_CPU_LIMIT=1.0
PG_MEM_LIMIT=1g

# SA4E-44 Environment Variables
# Copy to .env and fill in values

# --- Server ---
NODE_ENV=development
PORT=48721
# Per-IP rate limit (requests per minute). Defaults: 6000 in production, 10000 otherwise.
# Raise this when many clients share one egress IP (proxy/NAT) behind the remote server.
RATE_LIMIT_MAX_RPM=6000
# Set to 'true' when behind a reverse proxy so x-forwarded-for is used for the client IP.
TRUST_PROXY=false

# --- Database ---
DATABASE_ADAPTER=postgresql
DATABASE_URL=postgresql://sa4e_user:sa4e_local_dev_password@localhost:5432/sa4e_db

# --- Task Worker (Part 1) ---
TASK_WORKER_ENABLED=true
TASK_WORKER_POLL_INTERVAL_MS=5000
TASK_WORKER_MAX_RETRIES=3
TASK_WORKER_BACKOFF_BASE_MS=1000
TASK_WORKER_MAX_CONCURRENT=1
TASK_WORKER_DEAD_LETTER_ENABLED=true

# --- Code Intelligence (Part 2) ---
CODE_INTEL_ENABLED=true
CODE_INTEL_MAX_BATCH_SIZE=100
CODE_INTEL_UPLOAD_TIMEOUT_MS=30000
CODE_INTEL_VECTOR_ENABLED=false

# --- ONNX Runtime (optional --- for embeddings) ---
ONNX_RUNTIME_URL=http://localhost:8080
ONNX_MODEL_PATH=./models/all-MiniLM-L6-v2

# --- Security ---
API_KEY=
API_KEY_REQUIRED=false

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=pretty

# =============================================================================
# SA4E-241 — Incremental Checksum Indexing (env template — placeholders only)
# =============================================================================

# --- Auth / tenant isolation (SEC-01) ---
# When true, /pega/* requires identity (X-Project-Id header or JWT `pid` claim).
# projectId is derived from the authenticated identity — body.projectId is only
# used to cross-check (mismatch -> 403). NEVER a hardcoded default.
CODE_INTEL_REQUIRE_AUTH=false
# JWT signing/verification secret. Set a strong random value in real envs.
# Leave EMPTY here — do NOT commit a real secret. Use a secret manager in prod.
KB_TOKEN_SECRET=

# --- Pega credentials (SEC-03) — DO NOT hardcode; DO NOT commit real values ---
# Credentials must be provided by the extension via VS Code SecretStorage and
# forwarded per-request (authHeader). These template keys exist only for local
# manual testing. The leaked pair SSA@TGB / pega123! MUST be rotated and is
# blocked by scripts/check-secrets.sh — use your own operator id/password here.
PEGA_ENDPOINT=http://localhost:8080/prweb
PEGA_USERNAME=<your-pega-operator-id>
PEGA_PASSWORD=<your-pega-password>

# --- Checksum download / zip-bomb guards (SEC-05) ---
# Trần tài nguyên cho resumable download + ZIP extraction (chống DoS/zip-bomb).
CHECKSUM_MAX_TOTAL_SIZE=209715200        # 200 MB — trần tổng bytes tải về
CHECKSUM_MAX_CHUNKS=4096                  # trần số chunk (chống loop vô hạn)
CHECKSUM_MAX_UNCOMPRESSED_SIZE=524288000  # 500 MB — trần tổng bytes sau giải nén
CHECKSUM_MAX_ZIP_ENTRIES=50000            # trần số entry trong ZIP

# --- Bulk-check limits (SEC-04) ---
# Server-side cap on checksums per bulk-check request (client batches <= 1000).
BULK_CHECK_MAX_CHECKSUMS=5000
